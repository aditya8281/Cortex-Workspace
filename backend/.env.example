# CORTEX Backend — Environment Configuration
# Copy this file to .env and fill in your values.
#   cp .env.example .env

# ── Required ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
SECRET_KEY=

# PostgreSQL connection (port 5435 is user-space PG from start.sh)
DATABASE_URL=postgresql://cortex:cortex@localhost:5435/cortex

# ── Storage ───────────────────────────────────────────────────────────────────
CORTEX_ROOT=~/CortexStorage
MEMORY_PATH=
VAULT_PATH=

# ── LLM Providers ─────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
LLM_PROVIDER=auto
LLM_CONTEXT_SIZE=4096
LLM_GPU_LAYERS=0

# ── Redis (optional — fails open) ─────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (overrides default localhost list)
CORS_ORIGINS=

# ── Features ──────────────────────────────────────────────────────────────────
ENV=development
DEBUG=false
CORTEX_NEW_AGENT_LOOP=false
RATE_LIMIT_ENABLED=true
HTTPS_REDIRECT_ENABLED=false
