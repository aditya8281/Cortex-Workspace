# CORTEX Environment Configuration
# Copy this file to .env and fill in the values

# ── Required ─────────────────────────────────────────────────────────────
# Generate SECRET_KEY: openssl rand -hex 32
SECRET_KEY=
DATABASE_URL=postgresql://cortex:cortex@localhost:5435/cortex

# ── App ──────────────────────────────────────────────────────────────────
APP_NAME=CORTEX
API_V1_PREFIX=/api/v1
ENV=development
DEBUG=false

# ── Redis (optional, graceful fallback) ──────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Storage Paths (optional, defaults to project root) ───────────────────
# CORTEX_ROOT=/path/to/storage
# MEMORY_PATH=/path/to/memory
# VAULT_PATH=/path/to/vault

# ── Embeddings ───────────────────────────────────────────────────────────
# EMBEDDING_DIM=768
# EMBEDDING_MODEL_PATH=
# EMBEDDING_MODEL_NAME=nomic-embed-text

# ── Qdrant Vector DB ────────────────────────────────────────────────────
# QDRANT_HOST=localhost
# QDRANT_PORT=6333

# ── LLM ──────────────────────────────────────────────────────────────────
# LLM_PROVIDER=auto              # auto, llama_cpp, ollama, none
# LLM_MODEL_PATH=                # Path to GGUF model file
# OLLAMA_BASE_URL=http://localhost:11434
# LLM_CONTEXT_SIZE=8192          # Context window in tokens
# LLM_GPU_LAYERS=0               # GPU offload layers (0 = CPU only)
# LLM_THREADS=8                  # CPU threads for llama.cpp
# LLM_BATCH_SIZE=2048            # Prompt processing batch size
# LLM_MAX_TOKENS=2048            # Max tokens per generation
# LLM_TEMPERATURE=0.7            # Generation temperature
# LLM_CONCURRENCY=4              # Max concurrent LLM requests
# LLM_USE_MMAP=true              # Memory-map model (fast NVMe)
# LLM_TIMEOUT=120.0

# ── Rate Limiting ────────────────────────────────────────────────────────
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_REQUESTS=100
# RATE_LIMIT_WINDOW_SECONDS=60

# ── Feature Flags ────────────────────────────────────────────────────────
# CORTEX_NEW_AGENT_LOOP=false

# ── HTTPS ────────────────────────────────────────────────────────────────
# HTTPS_REDIRECT_ENABLED=false
# HTTPS_REDIRECT_PORT=443

# ── CORS (production only) ──────────────────────────────────────────────
# CORS_ORIGINS=https://yourdomain.com
