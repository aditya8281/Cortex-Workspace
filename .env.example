# =========================
# APPLICATION CONFIG
# =========================
APP_NAME=Cortex Workspace
DEBUG=True
API_V1_PREFIX=/api/v1

# =========================
# SECURITY
# =========================
SECRET_KEY=change_this_to_a_secure_random_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# =========================
# DATABASE
# =========================
DATABASE_URL=sqlite:///./app.db

# =========================
# WORKSPACEROOT
# =========================
WORKSPACE_ROOT=.

# =========================
# ENVIRONMENT
# =========================
ENV=development