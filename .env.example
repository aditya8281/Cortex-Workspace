# =============================================================================
# Cortex Workspace — Environment Configuration
# =============================================================================
# Copy this file to .env and update the values.

# ── Security ──────────────────────────────────────────────────────────────────
# Generate a strong random key: openssl rand -hex 32
SECRET_KEY=change_this_to_a_secure_random_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://cortex:cortex@localhost:5432/cortex

# ── Redis (optional — graceful fallback if unavailable) ───────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=Cortex Workspace
DEBUG=false
ENV=development
API_V1_PREFIX=/api/v1

# ── Storage Paths ─────────────────────────────────────────────────────────────
# Leave blank to use the default (ProjectRoot/CortexMemory/)
# CORTEX_ROOT=/path/to/CortexMemory
# MEMORY_PATH=/path/to/memory
# VAULT_PATH=/path/to/vault

# ── Frontend ──────────────────────────────────────────────────────────────────
# Set this to the backend URL for the Next.js API proxy
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
